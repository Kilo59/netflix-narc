Output docs/assets/recordings/lineup_filtering.gif

# Import shared appearance configuration
Source tapes/_common.tape

# Launch TUI
Type "netflix-narc"
Enter
Sleep 1.5s

# Open Lineup Screen
Type "l"
Sleep 1.5s

# Open Interrogation Room
Type "i"
Sleep 1.5s

# Close back to main view
Escape
Sleep 1s
